  "tokens": {
    "accent":                  { "light": "Lagoon700",    "dark": "Lagoon500",       "use": "Primary buttons, focus ring, selection (filled buttons carry onAccent text)" },
    "accentHover":             { "light": "Lagoon800",    "dark": "Lagoon400",       "use": "Hover/pressed primary" },
    "onAccent":                { "light": "Neutral0",     "dark": "DarkStone0",      "use": "Text and icons on accent" },
    "accentSubtle":            { "light": "Lagoon100",    "dark": "Lagoon1000",      "use": "Selected row, active sidebar item" },
    "lineSelection":           { "light": "Blue300",      "dark": "Blue600",         "use": "Selected lines of a diff or conflict (blue, so it never blends with the green/red change colors)" },
    "accentText":              { "light": "Lagoon800",    "dark": "Lagoon400",       "use": "Links, resolved labels" },
    "accentVivid":             { "light": "Lagoon500",    "dark": "Lagoon400",       "use": "Decorative accent: side-menu marker, avatar (never behind text)" },
    "background":              { "light": "Neutral0",     "dark": "DarkStone100",    "use": "Cards and editors: the list card, diff, conflict editor" },
    "surfaceSunken":           { "light": "Stone50",      "dark": "DarkStone0",      "use": "Window chrome: side menu, toolbar, dotted canvas, card headers, gutter" },
    "surfaceRaised":           { "light": "Neutral0",     "dark": "DarkStone200",    "use": "Popovers, selected side-menu tile, pill hover" },
    "border":                  { "light": "Stone300",     "dark": "DarkStone300",    "use": "Card, pill and pane borders" },
    "borderStrong":            { "light": "Stone400",     "dark": "DarkStone400",    "use": "Canvas dot grid, placeholder icons (decorative)" },
    "railSelectedIcon":        { "light": "Coral600",     "dark": "Coral300",        "use": "Icon of the selected side-menu tile" },
    "text":                    { "light": "Stone1000",    "dark": "DarkStone1000",   "use": "Body text, code" },
    "textSubtle":              { "light": "Stone700",     "dark": "DarkStone700",    "use": "Secondary labels, line numbers" },
    "conflictCurrentHeader":   { "light": "Teal200",      "dark": "Teal900",         "use": "Current (ours) header" },
    "conflictCurrentBody":     { "light": "Teal100",      "dark": "Teal1000",        "use": "Current (ours) lines" },
    "conflictIncomingHeader":  { "light": "Blue200",      "dark": "Blue900",         "use": "Incoming (theirs) header" },
    "conflictIncomingBody":    { "light": "Blue100",      "dark": "Blue1000",        "use": "Incoming (theirs) lines" },
    "conflictBaseHeader":      { "light": "Purple200",    "dark": "Purple900",       "use": "Base (diff3) header" },
    "conflictBaseBody":        { "light": "Purple100",    "dark": "Purple1000",      "use": "Base (diff3) lines" },
    "danger":                  { "light": "Red700",       "dark": "Red400",          "use": "Unresolved count, errors" },
    "warning":                 { "light": "Orange700",    "dark": "Orange400",       "use": "Binary file, encoding fallback, unsaved" },
    "info":                    { "light": "Blue700",      "dark": "Blue400",         "use": "Info banners, compare link" },
    "minimapCurrent":          { "light": "Teal600",      "dark": "Teal500",         "use": "Minimap tick: current" },
    "minimapIncoming":         { "light": "Blue600",      "dark": "Blue500",         "use": "Minimap tick: incoming" },
    "minimapUnresolved":       { "light": "Red600",       "dark": "Red500",          "use": "Minimap tick: unresolved" },
    "diffAddedBody":           { "light": "Green100",     "dark": "Green1000",       "use": "Diff: added lines" },
    "diffRemovedBody":         { "light": "Red100",       "dark": "Red1000",         "use": "Diff: removed lines" },
    "diffHunkHeader":          { "light": "Stone100",     "dark": "DarkStone250",    "use": "Diff: @@ hunk header row" },
    "syntaxKeyword":           { "light": "Purple700",    "dark": "Purple300",       "use": "Syntax: keywords" },
    "syntaxString":            { "light": "Green800",     "dark": "Green300",        "use": "Syntax: strings" },
    "syntaxNumber":            { "light": "Orange700",    "dark": "Orange300",       "use": "Syntax: numbers" },
    "syntaxComment":           { "light": "Stone700",     "dark": "DarkStone700",    "use": "Syntax: comments" },
    "syntaxType":              { "light": "Blue700",      "dark": "Blue300",         "use": "Syntax: types" },
    "syntaxIdentifier":        { "light": "Yellow800",    "dark": "Yellow300",       "use": "Syntax: pbxproj UUIDs" }
  },
  "accentChoices": {
    "teal":   {},
    "green":  { "accent": ["Green700",  "Green400"], "accentHover": ["Green800",  "Green300"], "accentSubtle": ["Green100",  "Green1000"], "accentText": ["Green800",  "Green300"], "accentVivid": ["Green500",  "Green300"] },
    "blue":   { "accent": ["Blue700",  "Blue400"], "accentHover": ["Blue900",  "Blue300"], "accentSubtle": ["Blue100",  "Blue1000"], "accentText": ["Blue700",  "Blue300"], "accentVivid": ["Blue500",  "Blue300"] },
    "purple": { "accent": ["Purple700",  "Purple300"], "accentHover": ["Purple900",  "Purple200"], "accentSubtle": ["Purple100",  "Purple1000"], "accentText": ["Purple700",  "Purple200"], "accentVivid": ["Purple500",  "Purple300"] },
    "orange": { "accent": ["Orange700",  "Orange400"], "accentHover": ["Orange800",  "Orange300"], "accentSubtle": ["Orange100",  "Orange1000"], "accentText": ["Orange800",  "Orange300"], "accentVivid": ["Orange400",  "Orange300"] }
  },
  "contrast": {
    "minimum": 4.5,
    "pairs": [
      ["text",  "background"],
      ["text",  "surfaceSunken"],
      ["text",  "surfaceRaised"],
      ["accentText",  "surfaceSunken"],
      ["textSubtle",  "surfaceRaised"],
      ["textSubtle",  "background"],
      ["textSubtle",  "surfaceSunken"],
      ["onAccent",  "accent"],
      ["accentText",  "background"],
      ["text",  "accentSubtle"],
      ["text",  "conflictCurrentHeader"],
      ["text",  "conflictCurrentBody"],
      ["text",  "conflictIncomingHeader"],
      ["text",  "conflictIncomingBody"],
      ["text",  "conflictBaseHeader"],
      ["text",  "conflictBaseBody"],
      ["text",  "diffAddedBody"],
      ["text",  "diffRemovedBody"],
      ["text",  "diffHunkHeader"],
      ["accentText",  "diffHunkHeader"],
      ["danger",  "background"],
      ["warning",  "background"],
      ["info",  "background"],
      ["syntaxKeyword",  "background"],
      ["syntaxString",  "background"],
      ["syntaxNumber",  "background"],
      ["syntaxComment",  "background"],
      ["syntaxType",  "background"],
      ["syntaxIdentifier",  "background"]
    ]
